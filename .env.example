# ========================================
# Environment Variables for Railway Deployment
# ========================================

# Database Configuration (provided by Railway MySQL plugin)
DB_URL=jdbc:mysql://YOUR_RAILWAY_MYSQL_HOST:3306/railway?useSSL=false&serverTimezone=UTC
DB_USER=root
DB_PASS=YOUR_RAILWAY_MYSQL_PASSWORD

# Example Railway MySQL connection:
# DB_URL=jdbc:mysql://containers-us-west-123.railway.app:7890/railway?useSSL=false&serverTimezone=UTC
# DB_USER=root
# DB_PASS=generated_password_from_railway
